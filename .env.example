# ============================================================
# SERVEUR (VM) UNIQUEMENT
# ============================================================
# Ne jamais renseigner de valeur secrete reelle dans ce fichier
# .env.example (utilise comme reference/modele, verse au depot).

# --- Moteur legacy_vm (BOT_EXECUTION_MODE=legacy_vm uniquement) ---
TARGET_URL=about:blank
CONNECT_TO_EXISTING_CHROME=false
CHROME_DEBUG_URL=http://127.0.0.1:9222
REFRESH_INTERVAL_MS=180000
HEADLESS=false
SLOW_MO_MS=200
DEBUG_KEEP_BROWSER_OPEN=true
MAX_REFRESH_ATTEMPTS=0
SCAN_MONTH_COUNT=0
MAX_PARALLEL_SCANS_PER_DOMAIN=1
MONTH_CLICK_MIN_DELAY_MS=5000
MONTH_CLICK_MAX_DELAY_MS=10000
BOT_CYCLE_COOLDOWN_MIN_MS=120000
BOT_CYCLE_COOLDOWN_MAX_MS=240000
REFRESH_EVERY_CYCLES=20
RATE_LIMIT_COOLDOWN_MINUTES=45

# --- Serveur web / PostgreSQL ---
WEB_PORT=3000
MAX_CLIENTS_PER_VM=15
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=SMART
PGDATABASE=vrdv

# --- Notifications Brevo ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notif.noreply@rendezbot.xyz
BREVO_SENDER_NAME=RendezBot
BREVO_SANDBOX=true
EMAIL_NOTIFY_NO_SLOT=false

# --- Passerelle agent (BOT_EXECUTION_MODE=agent): cote SERVEUR uniquement ---
BOT_EXECUTION_MODE=legacy_vm
AGENT_UI_ENABLED=false
# Override administratif (Phase 5, Lot 4): si defini, remplace l'URL de
# telechargement generee par le service de release interne. Doit etre
# https:// pour un hote distant (un hote local reste tolere en test
# explicite). Vide par defaut - le service interne (AGENT_RELEASES_DIR /
# AGENT_RELEASE_VERSION ci-dessous) reste la source par defaut.
AGENT_DOWNLOAD_URL=
AGENT_HEARTBEAT_INTERVAL_MS=10000
AGENT_OFFLINE_TIMEOUT_MS=40000
AGENT_MIN_VERSION=0.1.0
# Plage de PROTOCOLE (Phase 5, Lot 2 - correctif protocole), distincte de
# AGENT_MIN_VERSION (version applicative). Un agent qui n'envoie pas ce champ,
# ou une valeur hors de cette plage (trop ancienne OU trop recente), est
# rejete avec VERSION_INCOMPATIBLE.
AGENT_MIN_PROTOCOL_VERSION=1
AGENT_MAX_PROTOCOL_VERSION=1
AGENT_PAIRING_CODE_TTL_MINUTES=10
AGENT_PAIRING_MAX_ATTEMPTS=5
AGENT_COMMAND_ACK_TIMEOUT_MS=10000
AGENT_COMMAND_TTL_MS=60000
AGENT_COMMAND_SWEEP_INTERVAL_MS=5000

# --- Publication de l'installateur agent (Phase 5, Lot 4) ---
# Dossier serveur contenant les releases, structure attendue:
#   <AGENT_RELEASES_DIR>/<version>/RendezBotAgentSetup-<version>.exe
#   <AGENT_RELEASES_DIR>/<version>/SHA256SUMS.txt
#   <AGENT_RELEASES_DIR>/<version>/build-manifest.json
# Vide par defaut: aucune release n'est jamais devinee/activee
# automatiquement. Ne JAMAIS pointer vers un dossier suivi par Git.
AGENT_RELEASES_DIR=
# Version EXPLICITEMENT approuvee pour publication (format X.Y.Z) - jamais
# une selection automatique du dernier dossier trouve sur disque.
AGENT_RELEASE_VERSION=
# candidate | stable | deprecated | blocked
AGENT_RELEASE_CHANNEL=candidate

# ============================================================
# AGENT (PC LOCAL) UNIQUEMENT — jamais lu par le serveur
# ============================================================
# A renseigner dans l'environnement du PC qui execute
# `npm run agent:dev`, jamais dans le .env du serveur/VM.

AGENT_SERVER_URL=http://localhost:3000
AGENT_CREDENTIALS_PATH=
AGENT_COMPUTER_NAME=
AGENT_DATA_DIR=
AGENT_MAX_ACTIVE_BOTS=15
CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Mode cible: "production" (defaut) ou "fixture" (jamais implicite - toujours
# explicite, et AGENT_FIXTURE_URL devient alors obligatoire).
AGENT_TARGET_MODE=production
AGENT_FIXTURE_URL=
AGENT_TARGET_URL=about:blank

# Reconnexion (backoff exponentiel + jitter)
AGENT_RECONNECT_MIN_DELAY_MS=1000
AGENT_RECONNECT_MAX_DELAY_MS=30000
AGENT_RECONNECT_JITTER_RATIO=0.2

# Buffer d'evenements hors ligne (borne stricte)
AGENT_OFFLINE_EVENT_BUFFER_MAX=500

# Logs locaux (%LOCALAPPDATA%\RendezBot\logs\agent.log)
AGENT_LOG_MAX_FILE_SIZE_MB=5
AGENT_LOG_MAX_FILES=5
AGENT_LOG_LEVEL=info

# ============================================================
# TESTS UNIQUEMENT — jamais utilises en production
# ============================================================
# Ports/URLs de test: chaque script de test choisit deja son propre port
# fixe (documente dans docs/agent-testing.md); ces variables ne servent
# qu'aux scripts qui les lisent explicitement (test-agent-phase1.ts/
# test-agent-phase3.ts, harnais manuels).
TEST_AGENT_SERVER_URL=
TEST_PATCH_PAIRING_PORT=
TEST_REVOKE_PORT=

# Duree du test de stabilite (soak), en minutes.
AGENT_SOAK_TEST_DURATION_MINUTES=10
