{
  "name": "rdv-agent",
  "version": "0.1.0",
  "description": "MVP Node.js + TypeScript + Playwright pour un agent navigateur local.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "web:dev": "tsx src/server.ts",
    "agent:dev": "tsx src/agent/agentMain.ts",
    "db:init": "tsx src/initDb.ts",
    "build": "tsc",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-win.ps1",
    "agent:package:win": "powershell -ExecutionPolicy Bypass -File scripts/agent-package-win.ps1",
    "start": "node dist/index.js",
    "web:start": "node dist/server.js",
    "playwright:install": "playwright install chromium",
    "test:agent:packaging:simulated": "tsx scripts/test-agent-packaging-simulated.ts",
    "test:agent:packaging:real": "tsx scripts/test-agent-packaging-real.ts",
    "test:agent:packaging-lot2:simulated": "tsx scripts/test-agent-packaging-lot2-simulated.ts",
    "test:agent:packaging-lot2:real": "tsx scripts/test-agent-packaging-lot2-real.ts",
    "test:agent:packaging-lot3:simulated": "tsx scripts/test-agent-packaging-lot3-simulated.ts",
    "test:agent:packaging-lot3:real": "tsx scripts/test-agent-packaging-lot3-real.ts",
    "test:agent:protocol-auth:real": "tsx scripts/test-agent-protocol-auth-real.ts",
    "test:agent:release:simulated": "tsx scripts/test-agent-release-simulated.ts",
    "test:agent:release:integration": "tsx scripts/test-agent-release-integration.ts",
    "test:agent:hotfix-autologin:real": "tsx scripts/test-agent-hotfix-autologin-real.ts",
    "test:agent:bot-status:simulated": "tsx scripts/test-agent-bot-status-simulated.ts",
    "test:agent:bot-status:real": "tsx scripts/test-agent-bot-status-real.ts",
    "test:agent:validate:simulated": "tsx scripts/test-agent-validate-simulated.ts",
    "test:agent:validate:real": "tsx scripts/test-agent-validate-real.ts",
    "test:agent:monitoring:simulated": "tsx scripts/test-agent-monitoring-simulated.ts",
    "test:agent:monitoring:real": "tsx scripts/test-agent-monitoring-real.ts",
    "test:agent:resilience:simulated": "tsx scripts/test-agent-resilience-simulated.ts",
    "test:agent:resilience:real": "tsx scripts/test-agent-resilience-real.ts",
    "test:agent:security:simulated": "tsx scripts/test-agent-security-simulated.ts",
    "test:agent:soak:real": "tsx scripts/test-agent-soak-real.ts",
    "test:phase4:final:simulated": "tsx scripts/test-phase4-final-simulated.ts",
    "test:phase4:final:real": "tsx scripts/test-phase4-final-real.ts",
    "test:phase4:smoke": "tsx scripts/test-phase4-smoke.ts"
  },
  "keywords": [
    "playwright",
    "typescript",
    "browser-agent"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "playwright": "^1.49.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
